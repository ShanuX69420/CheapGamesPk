# What the browser calls. Absolute — the API client builds URLs with `new URL()`.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
# What a server render calls. Only differs from the above in production, where
# the browser goes through nginx and the server talks to gunicorn directly.
INTERNAL_API_URL=
NEXT_PUBLIC_STORE_CURRENCY=PKR
# Meta pixel (dataset) id from Events Manager. Blank keeps the pixel off the
# page entirely, which is what you want in development. Baked in at build time
# — changing it means rebuilding. The backend needs the same id as
# META_PIXEL_ID to report sales.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
