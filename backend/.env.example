# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Karachi

# Unset uses the local SQLite file. In production:
# DATABASE_URL=postgres://cheapgamespk:PASSWORD@127.0.0.1:5432/cheapgamespk
DATABASE_URL=

# Only needed when the frontend is served from a different origin than the API.
# Behind the production nginx they share one origin, so this stays empty there.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required once behind HTTPS or the admin login POST is rejected.
# e.g. https://cheapgames.pk,https://www.cheapgames.pk
CSRF_TRUSTED_ORIGINS=

STORE_CURRENCY=PKR
# Digits only, with country code. 92 = Pakistan. The store sells through this
# number and nothing else — blank hides every buy button.
WHATSAPP_NUMBER=923001234567
# Public storefront URL. The admin builds each order's link from it.
SITE_URL=http://localhost:3000

# Products per catalog page.
# Leave unset unless something in front of Django already redirects to
# https. Behind our nginx it must be False, or server-side rendering gets
# a 301 where it expects JSON.
SECURE_SSL_REDIRECT=

CATALOG_PAGE_SIZE=24
# Rate limit on anonymous order creation.
THROTTLE_ORDER_CREATE=20/hour
