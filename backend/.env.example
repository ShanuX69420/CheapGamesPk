# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Karachi

# Unset uses the local SQLite file. In production:
# DATABASE_URL=postgres://cheapgamespk:PASSWORD@127.0.0.1:5432/cheapgamespk
DATABASE_URL=

# Only needed when the frontend is served from a different origin than the API.
# Behind the production nginx they share one origin, so this stays empty there.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required once behind HTTPS or the admin login POST is rejected.
# e.g. https://cheapgames.pk,https://www.cheapgames.pk
CSRF_TRUSTED_ORIGINS=

STORE_CURRENCY=PKR
# Digits only, with country code. 92 = Pakistan. The store sells through this
# number and nothing else — blank hides every buy button.
WHATSAPP_NUMBER=923001234567
# Public storefront URL. The admin builds each order's link from it.
SITE_URL=http://localhost:3000

# Meta ads. The pixel id is the same one the frontend gets as
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID; the token comes from Events Manager >
# Settings > Conversions API and is what lets the server report a sale after
# the buyer has left. Both blank sends nothing anywhere.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Set to the code in the Test events tab while checking the wiring, then clear
# it — events sent with it set never reach the live dataset.
META_TEST_EVENT_CODE=
# Only to pin a Graph API version; the default is current.
META_GRAPH_API_VERSION=

# Google Analytics 4. The measurement id is the same one the frontend gets as
# NEXT_PUBLIC_GA_MEASUREMENT_ID; the secret comes from Admin > Data streams >
# the stream > Measurement Protocol API secrets, and is what lets the server
# report a sale after the buyer has left. Both blank sends nothing anywhere.
GA_MEASUREMENT_ID=
GA_API_SECRET=
# Set while checking the wiring: events are validated and thrown away instead
# of recorded, and anything wrong with them lands in the log. The live endpoint
# accepts everything without comment, so this is the only way to be told. Clear
# it to go live.
GA_DEBUG=

# Products per catalog page.
# Leave unset unless something in front of Django already redirects to
# https. Behind our nginx it must be False, or server-side rendering gets
# a 301 where it expects JSON.
SECURE_SSL_REDIRECT=

CATALOG_PAGE_SIZE=24
# Rate limit on anonymous order creation.
THROTTLE_ORDER_CREATE=20/hour
